# Environment variables template
# Copy this file to backend/.env and fill in your values

# Server Configuration
PORT=3001
NODE_ENV=development

# Database
DB_PATH=./instagram_dm.db

# Rate Limiting
MAX_DM_PER_HOUR=30
MIN_DELAY_SECONDS=10
MAX_DELAY_SECONDS=90

# Security - CHANGE THIS TO A RANDOM 32 CHARACTER STRING
ENCRYPTION_KEY=change_this_to_random_32_char_key_for_production

# Browser Settings
HEADLESS=true
BROWSER_DATA_DIR=./.browser-data

# Optional: Redis (for BullMQ, not required for MVP)
# REDIS_HOST=localhost
# REDIS_PORT=6379
