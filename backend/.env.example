# Server Configuration
PORT=3001
NODE_ENV=development

# Instagram Configuration (будут храниться зашифрованными в БД)
# INSTAGRAM_USERNAME=your_username
# INSTAGRAM_PASSWORD=your_password

# Database
DB_PATH=./instagram_dm.db

# Redis (для BullMQ, опционально для MVP можно использовать in-memory очередь)
REDIS_HOST=localhost
REDIS_PORT=6379

# Rate Limiting
MAX_DM_PER_HOUR=30
MIN_DELAY_SECONDS=10
MAX_DELAY_SECONDS=90

# Security
ENCRYPTION_KEY=change_this_to_random_32_char_key_for_production

# Browser Settings
HEADLESS=true
BROWSER_DATA_DIR=./.browser-data
